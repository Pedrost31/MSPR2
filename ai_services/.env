# MongoDB (même base que le backend Node.js)
MONGODB_URI=mongodb://host.docker.internal:27017/healthai

# Ollama – LLM local installé sur ta machine
OLLAMA_URL=http://localhost:11434
OLLAMA_VISION_MODEL=llava:latest
OLLAMA_TEXT_MODEL=llama3.2:latest

