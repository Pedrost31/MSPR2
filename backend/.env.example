# Server
NODE_ENV=development
PORT=5000

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:55432/healthai

# MongoDB
MONGODB_URI=mongodb://localhost:27017/healthai

# JWT
JWT_SECRET=change-this-super-secret-jwt-key-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-this-super-secret-refresh-key-in-production
JWT_REFRESH_EXPIRES_IN=7d

# OpenAI (optional – mock mode used if absent)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# CORS
CORS_ORIGIN=http://localhost:5173

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
